{
  "name": "media-sorter",
  "version": "1.0.1",
  "description": "Sort photos and videos with thumbnail/fullscreen views, keyboard navigation, trash and rename.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist:linux": "electron-builder --linux AppImage deb",
    "dist:mac": "electron-builder --mac dmg"
  },
  "author": "mc <273350363+mc4spam-cell@users.noreply.github.com>",
  "license": "MIT",
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "ffmpeg-static": "^5.2.0",
    "trash": "^7.2.0"
  },
  "build": {
    "appId": "com.mc.mediasorter",
    "productName": "Media Sorter",
    "asar": false,
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "package.json"
    ],
    "fileAssociations": [
      {
        "ext": ["jpg", "jpeg", "png", "webp", "gif", "bmp", "tiff", "tif", "avif"],
        "name": "Image",
        "description": "Image",
        "role": "Viewer",
        "mimeType": "image/jpeg;image/png;image/webp;image/gif;image/bmp;image/tiff;image/avif"
      }
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Graphics"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.photography"
    }
  }
}
