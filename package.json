{
  "name": "media-sorter",
  "version": "1.2.1",
  "description": "Sort photos and videos with thumbnail/fullscreen views, keyboard navigation, multi-selection, undoable trash, rename, move and copy.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist:linux": "electron-builder --linux AppImage deb",
    "dist:mac": "electron-builder --mac dmg"
  },
  "author": "mc <273350363+mc4spam-cell@users.noreply.github.com>",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "electron": "^44.9.0",
    "electron-builder": "^26.17.0"
  },
  "dependencies": {
    "ffmpeg-static": "^5.2.0",
    "trash": "^9.0.0"
  },
  "build": {
    "appId": "com.mc.mediasorter",
    "productName": "Media Sorter",
    "asar": false,
    "afterPack": "./build/afterPack.js",
    "files": [
      "main.js",
      "preload.js",
      "lib/**/*",
      "renderer/**/*",
      "package.json"
    ],
    "fileAssociations": [
      {
        "ext": ["jpg", "jpeg", "png", "webp", "gif", "bmp", "avif"],
        "name": "Image",
        "description": "Image",
        "role": "Viewer",
        "mimeType": "image/jpeg;image/png;image/webp;image/gif;image/bmp;image/avif"
      }
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Graphics"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.photography",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    }
  }
}
